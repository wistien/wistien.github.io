---
import Base from '../layouts/Base.astro';
import schema from '../data/home-schema.json';

// sitemap.xml 會讀這個日期；主要文字、結構化資料或連結有修改時改成當天（只改樣式不用改）
export const lastmod = '2026-11-19';

const title = "阿中與小夢的旅遊官方｜海外團體旅遊報名・旅遊保險・自助旅遊資源";
const description = "阿中與小夢的旅遊官方｜海外團體旅遊報名、旅遊保險諮詢、自助旅遊資源與出國網路 eSIM。透過 LINE 官方帳號，讓旅行輕鬆成為一件美好的事。";
const ogTitle = "阿中與小夢的旅遊官方｜海外團體旅遊報名・旅遊保險・自助旅遊資源";
const ogDescription = "海外團體旅遊報名・旅遊保險諮詢・自助旅遊資源・出國網路 eSIM";
const ogImageAlt = "阿中與小夢的旅遊官方：海外團體旅遊報名、旅遊保險、代理 40+ 家旅行社";
---
<Base title={title} description={description} ogTitle={ogTitle} ogDescription={ogDescription} ogImageAlt={ogImageAlt} path="/" schema={schema}>
<Fragment slot="preload"><link rel="preload" as="image" type="image/webp" imagesrcset="/images/opt/photo-5-960.webp 960w, /images/opt/photo-5-1280.webp 1280w" imagesizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)" fetchpriority="high"></Fragment>

<!-- HERO -->
<section id="hero">
  <div class="hero-deco hero-deco-1"></div>
  <div class="hero-deco hero-deco-2"></div>
  <div class="hero-content">
    <div>
      <p class="hero-label">From Dream to Departure</p>
      <h1 class="hero-title"><em>世界遼闊</em><br>別把人生只留給日常</h1>
      <p class="hero-desc">阿中與小夢，陪您把旅行想得更周全。<br>提供團體旅遊報名、旅遊保險與行程比較等服務，<br>從挑選行程到安心出發，為您打理每一個細節。</p>
      <div class="hero-actions">
        <a href="#services" class="btn-primary">探索服務 →</a>
        <a href="https://lin.ee/59m3bLP" target="_blank" rel="noopener" class="btn-line">💬 加 LINE 諮詢</a>
      </div>
    </div>
    <div class="hero-visual">
      <div class="hero-carousel" id="carousel">
        <div class="slide active">
          <picture>
            <source type="image/webp" srcset="/images/opt/photo-5-960.webp 960w, /images/opt/photo-5-1280.webp 1280w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img src="/images/photo-5.jpg" alt="紐西蘭皇后鎮瓦卡蒂普湖畔" fetchpriority="high">
          </picture>
          <span class="slide-caption">紐西蘭 · 瓦卡蒂普湖畔小鎮風光</span>
        </div>
        <div class="slide">
          <picture>
            <source type="image/webp" data-srcset="/images/opt/photo-10-960.webp 960w, /images/opt/photo-10-1280.webp 1280w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img data-src="/images/photo-10.jpg" alt="瑞士格林德瓦艾格峰" decoding="async">
          </picture>
          <span class="slide-caption">瑞士 · 格林德瓦艾格峰</span>
        </div>
        <div class="slide">
          <picture>
            <source type="image/webp" data-srcset="/images/opt/photo-12-960.webp 960w, /images/opt/photo-12-1280.webp 1280w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img data-src="/images/photo-12.jpg" alt="日本富士山" decoding="async">
          </picture>
          <span class="slide-caption">日本 · 富士山</span>
        </div>
        <div class="slide">
          <picture>
            <source type="image/webp" data-srcset="/images/opt/photo-14-960.webp 960w, /images/opt/photo-14-1280.webp 1280w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img data-src="/images/photo-14.jpg" alt="埃及人面獅身像" decoding="async">
          </picture>
          <span class="slide-caption">埃及 · 人面獅身像</span>
        </div>
        <div class="slide">
          <picture>
            <source type="image/webp" data-srcset="/images/opt/photo-7-960.webp 960w, /images/opt/photo-7-1179.webp 1179w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img data-src="/images/photo-7.jpg" alt="紐西蘭瓦納卡湖畔" decoding="async">
          </picture>
          <span class="slide-caption">紐西蘭 · 絕美瓦納卡湖畔</span>
        </div>
        <div class="slide">
          <picture>
            <source type="image/webp" data-srcset="/images/opt/photo-11-960.webp 960w, /images/opt/photo-11-1280.webp 1280w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img data-src="/images/photo-11.jpg" alt="瑞士馬特洪峰日照金山" decoding="async">
          </picture>
          <span class="slide-caption">瑞士 · 馬特洪峰日照金山</span>
        </div>
        <div class="slide">
          <picture>
            <source type="image/webp" data-srcset="/images/opt/photo-13-960.webp 960w, /images/opt/photo-13-1280.webp 1280w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img data-src="/images/photo-13.jpg" alt="日本立山山脈夕陽金頂" decoding="async">
          </picture>
          <span class="slide-caption">日本 · 立山山脈夕陽金頂</span>
        </div>
        <div class="slide">
          <picture>
            <source type="image/webp" data-srcset="/images/opt/photo-9-960.webp 960w, /images/opt/photo-9-1280.webp 1280w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img data-src="/images/photo-9.jpg" alt="直升機上俯瞰庫克山脈冰河" decoding="async">
          </picture>
          <span class="slide-caption">紐西蘭 · 直升機上的冰河視角</span>
        </div>
        <div class="slide">
          <picture>
            <source type="image/webp" data-srcset="/images/opt/photo-15-960.webp 960w, /images/opt/photo-15-1280.webp 1280w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img data-src="/images/photo-15.jpg" alt="埃及阿布辛貝神殿" decoding="async">
          </picture>
          <span class="slide-caption">埃及 · 阿布辛貝神殿</span>
        </div>
        <div class="slide">
          <picture>
            <source type="image/webp" data-srcset="/images/opt/photo-8-960.webp 960w, /images/opt/photo-8-1280.webp 1280w" sizes="(max-width: 900px) calc(150vw - 4.5rem), min(78vw, 900px)">
            <img data-src="/images/photo-8.jpg" alt="紐西蘭清晨沿途的牧野風光" decoding="async">
          </picture>
          <span class="slide-caption">紐西蘭 · 清晨沿途的牧野風光</span>
        </div>
        <button class="car-arrow car-prev" onclick="moveSlide(-1)" aria-label="上一張">‹</button>
        <button class="car-arrow car-next" onclick="moveSlide(1)" aria-label="下一張">›</button>
        <div class="car-dots" id="carDots"></div>
      </div>
      <div class="hero-stats">
        <div class="stat-item">
          <span class="stat-num" data-target="1000" data-suffix="+">0</span>
          <span class="stat-label">服務旅客</span>
        </div>
        <div class="stat-item">
          <span class="stat-num" data-target="880" data-suffix="+">0</span>
          <span class="stat-label">LINE 好友</span>
        </div>
        <div class="stat-item">
          <span class="stat-num" data-target="40" data-suffix="+">0</span>
          <span class="stat-label">合作旅行社</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- MARQUEE -->
<div class="marquee-strip" aria-hidden="true">
  <div class="marquee-track" id="marqueeTrack">
    <span class="marquee-item">日本</span><span class="marquee-item">韓國</span><span class="marquee-item">泰國</span><span class="marquee-item">越南</span><span class="marquee-item">土耳其</span><span class="marquee-item">埃及</span><span class="marquee-item">杜拜</span><span class="marquee-item">法國</span><span class="marquee-item">瑞士</span><span class="marquee-item">義大利</span><span class="marquee-item">紐西蘭</span><span class="marquee-item">夏威夷</span>
  </div>
</div>

<!-- SERVICES -->
<section id="services">
  <svg class="mountains" aria-hidden="true" viewBox="0 0 1200 200" preserveAspectRatio="none">
    <path fill="rgba(155,106,62,0.05)" d="M0 200V120L150 58l150 72 120-60 140 80 140-70 150 60 150-70 200 70v100z"/>
    <path fill="rgba(176,58,46,0.04)" d="M0 200v-40l200-50 150 50 150-40 180 50 140-50 180 45 200-65v100z"/>
  </svg>
  <div class="section-inner">
    <div class="stamp" aria-hidden="true"><span class="stamp-char">遊</span><span class="stamp-sub">SERVICES</span></div>
    <div class="services-header reveal">
      <p class="section-label">Our Services</p>
      <h2 class="section-title">我們能為您做什麼</h2>
      <p class="section-subtitle">從出發前的規劃到旅途中的保障，全方位旅遊諮詢服務，瑣事交給我們，讓您安心出發。</p>
    </div>
    <div class="services-grid">
      <a class="service-card reveal" href="#process">
        <span class="service-num">01</span>
        <span class="service-icon">✈️</span>
        <h3 class="service-name">海外旅遊團體報名</h3>
        <p class="service-desc">綜合旅行社業務，代理雄獅、可樂、五福、東南、山富、鳳凰等 40+ 家旅行社團體行程，協助比較合適方案與可用優惠，出國跟團輕鬆報名。</p>
        <span class="service-tag">代理 40+ 家旅行社</span>
      </a>
      <a class="service-card reveal d1" href="#insurance">
        <span class="service-num">02</span>
        <span class="service-icon">🛡️</span>
        <h3 class="service-name">旅遊保險諮詢</h3>
        <p class="service-desc">與國泰產險合作，依旅程需求提供旅遊保障資訊整理與方案比較。</p>
        <span class="service-tag">國泰產險合作</span>
      </a>
      <a class="service-card reveal d2" href="#platforms">
        <span class="service-num">03</span>
        <span class="service-icon">🌐</span>
        <h3 class="service-name">自助旅遊資源</h3>
        <p class="service-desc">透過 Klook、KKday、Agoda、Trip.com、雄獅旅遊等平台聯盟連結，輕鬆預訂票券、住宿與行程。</p>
        <span class="service-tag">6+ 平台合作</span>
      </a>
      <a class="service-card reveal" href="#platforms">
        <span class="service-num">04</span>
        <span class="service-icon">📶</span>
        <h3 class="service-name">出國網路 eSIM</h3>
        <p class="service-desc">合作專屬 eSIM 平台，出國前輕鬆開通海外數據方案，全程保持網路暢通，旅途不斷線。</p>
        <span class="service-tag">eSIM 合作夥伴</span>
      </a>
      <a class="service-card reveal d1" href="#platforms">
        <span class="service-num">05</span>
        <span class="service-icon">🎒</span>
        <h3 class="service-name">網卡與旅遊好物分享</h3>
        <p class="service-desc">實體網卡與旅遊實用好物推薦持續整理中，之後會在合作平台專區與大家分享。</p>
        <span class="service-tag">敬請期待</span>
      </a>
    </div>
  </div>
</section>

<!-- PHOTO DIVIDER 1 -->
<div class="photo-divider" data-bg="photo-3" role="img" aria-label="紐西蘭山谷金色晚霞">
  <p class="divider-quote">世界很大，慢慢走<span>The world is wide — take your time.</span></p>
</div>

<!-- PROCESS -->
<section id="process">
  <svg class="mountains" aria-hidden="true" viewBox="0 0 1200 200" preserveAspectRatio="none">
    <path fill="rgba(155,106,62,0.06)" d="M0 200V120L150 58l150 72 120-60 140 80 140-70 150 60 150-70 200 70v100z"/>
    <path fill="rgba(176,58,46,0.045)" d="M0 200v-40l200-50 150 50 150-40 180 50 140-50 180 45 200-65v100z"/>
  </svg>
  <div class="section-inner">
    <div class="stamp" aria-hidden="true"><span class="stamp-char">程</span><span class="stamp-sub">PROCESS</span></div>
    <div class="reveal">
      <p class="section-label">How It Works</p>
      <h2 class="section-title">報名流程</h2>
      <p class="section-subtitle">簡單四步驟，從諮詢到出發，我們陪您走每一步。</p>
    </div>
    <div class="process-layout">
      <div class="process-steps reveal">
        <div class="process-step">
          <span class="step-num">01</span>
          <div>
            <h3 class="step-title">傳訊諮詢</h3>
            <p class="step-desc">透過 LINE 官方帳號聯繫我們，告知您的旅遊想法、出發日期與人數，我們將盡快回覆。如果您有看好的團，也歡迎直接丟給我們詢問優惠價~</p>
          </div>
        </div>
        <div class="process-step">
          <span class="step-num">02</span>
          <div>
            <h3 class="step-title">行程規劃與報價</h3>
            <p class="step-desc">根據您的需求，我們洽詢合適的旅行社方案並提供詳細報價，協助您做出最佳選擇。</p>
          </div>
        </div>
        <div class="process-step">
          <span class="step-num">03</span>
          <div>
            <h3 class="step-title">確認與繳費</h3>
            <p class="step-desc">確認行程後，依旅行社規定完成訂金或全額繳費，並收到行程確認通知。</p>
          </div>
        </div>
        <div class="process-step">
          <span class="step-num">04</span>
          <div>
            <h3 class="step-title">出發前準備</h3>
            <p class="step-desc">🏷️ 尾款：行前 1-2 週 or 通知開票時會與您收款<br>🏷️ 行前說明會＆完整行程資料：通常會在行前 7-10 天發下來</p>
          </div>
        </div>
      </div>
      <div class="process-box reveal d1">
        <h3 class="process-box-title">📋 諮詢注意事項</h3>
        <p class="process-box-sub">提前準備以下資訊，讓諮詢更順暢</p>
        <div class="flow-row"><div class="flow-dot"></div><span class="flow-text">目的地或旅遊方向</span></div>
        <div class="flow-connector"></div>
        <div class="flow-row"><div class="flow-dot"></div><span class="flow-text">預計出發日期與天數</span></div>
        <div class="flow-connector"></div>
        <div class="flow-row"><div class="flow-dot"></div><span class="flow-text">同行人數（大人／小孩）</span></div>
        <div class="flow-connector"></div>
        <div class="flow-row"><div class="flow-dot"></div><span class="flow-text">特殊需求或偏好</span></div>
        <div class="process-note">💬 一般於 <strong>24 小時內</strong> 回覆訊息。如有緊急需求，歡迎直接於 LINE 留言。</div>
      </div>
    </div>
    <div class="mini-cta reveal">
      <p>已經有想去的地方了嗎？告訴我們目的地、日期與人數，幫您快速整理方向。</p>
      <a href="https://lin.ee/59m3bLP" target="_blank" rel="noopener" class="btn-line">💬 傳訊開始規劃</a>
    </div>
  </div>
</section>

<!-- INSURANCE -->
<section id="insurance">
  <svg class="mountains" aria-hidden="true" viewBox="0 0 1200 200" preserveAspectRatio="none">
    <path fill="rgba(155,106,62,0.05)" d="M0 200V120L150 58l150 72 120-60 140 80 140-70 150 60 150-70 200 70v100z"/>
    <path fill="rgba(176,58,46,0.04)" d="M0 200v-40l200-50 150 50 150-40 180 50 140-50 180 45 200-65v100z"/>
  </svg>
  <div class="section-inner">
    <div class="stamp" aria-hidden="true"><span class="stamp-char">安</span><span class="stamp-sub">INSURANCE</span></div>
    <div class="reveal">
      <p class="section-label">Travel Insurance</p>
      <h2 class="section-title">旅遊保險</h2>
      <p class="section-subtitle">出門在外，平安是最重要的行李。我們與國泰產險合作，依旅程需求提供保障資訊整理與方案比較，讓您安心出發。</p>
    </div>
    <div class="insurance-grid">
      <div class="insurance-cards reveal">
        <div class="ins-card">
          <div class="ins-icon">🏦</div>
          <div><p class="ins-name">國泰產險</p><p class="ins-sub">旅遊綜合保險：旅平險、海外突發疾病、旅行不便險</p></div>
        </div>
        <div class="insurance-info">
          <h3 class="info-title">📞 出國遇到狀況，24 小時找得到人</h3>
          <ul class="info-list">
            <li>24 小時中文諮詢專線，人在國外也能撥打</li>
            <li>醫療問題口譯、推薦醫療院所、協助安排住院</li>
            <li>行李代尋轉送、旅遊文件協尋與補發</li>
            <li>緊急狀況協助預訂機票與住宿</li>
          </ul>
          <p class="ins-help-note">投保國泰海外旅遊保險即可使用，部分服務費用需先自付。</p>
        </div>
      </div>
      <div class="insurance-info reveal d1">
        <h3 class="info-title">🛡️ 國泰旅遊綜合保險可以保什麼</h3>
        <ul class="info-list">
          <li><span><strong>旅行平安</strong>：意外身故與失能、意外傷害醫療（實支實付）、重大燒燙傷</span></li>
          <li><span><strong>海外突發疾病</strong>：住院、門診、急診醫療，含法定傳染病</span></li>
          <li><span><strong>旅行不便</strong>：旅程取消、旅程更改、班機延誤、行李延誤、行李損失、旅行文件損失</span></li>
          <li><span><strong>旅行補償</strong>：改降非原定機場、劫機、食品中毒、現金被竊、信用卡盜用、出國期間住家遭竊</span></li>
          <li><span><strong>第三人責任與急難救助</strong>：在國外不小心造成他人受傷或財物損失的賠償，以及醫療轉送、親友前往探視等費用</span></li>
        </ul>
      </div>
    </div>
    <div class="contact-notes">
      <div class="note-item reveal">
        <p class="note-item-title">團費已含哪些保險？</p>
        <p class="note-item-desc">跟團的團費已含法定的旅行業責任保險；旅平險、突發疾病與旅行不便險需要另外投保。</p>
      </div>
      <div class="note-item reveal d1">
        <p class="note-item-title">旅程取消、更改的限制</p>
        <p class="note-item-desc">旅程取消與旅程更改，不包含因傳染病及檢疫造成的取消或更改。</p>
      </div>
      <div class="note-item reveal d2">
        <p class="note-item-title">延誤怎麼算？</p>
        <p class="note-item-desc">班機延誤 4 小時以上才給付；行李延誤是抵達目的地 6 小時後仍未領到，回程不算；行李箱本身毀損不在行李損失範圍。</p>
      </div>
    </div>
    <p class="ins-disclaimer reveal">實際保障內容、承保與理賠，<br>依保險公司保單條款及核保結果為準。</p>
    <div class="mini-cta reveal">
      <p>不確定該保哪些？告訴我們目的地與行程天數，我們幫您整理適合的保障資訊。</p>
      <a href="https://lin.ee/59m3bLP" target="_blank" rel="noopener" class="btn-line">💬 詢問保障資訊</a>
    </div>
  </div>
</section>

<!-- PHOTO DIVIDER 2 -->
<div class="photo-divider" data-bg="lakeside" role="img" aria-label="紐西蘭沿途湖畔風光">
  <p class="divider-quote">最好的風景，永遠在路上<span>The best views begin the moment you set off.</span></p>
</div>

