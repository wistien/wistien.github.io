<!-- FONT SIZE SWITCHER -->
<div class="fs-switch" id="fsSwitch">
  <div class="fs-panel" id="fsPanel" role="group" aria-label="選擇字體大小" hidden>
    <button type="button" class="fs-opt" data-fs="md" aria-pressed="true"><span class="fs-sample" aria-hidden="true">字</span>標準</button>
    <button type="button" class="fs-opt" data-fs="lg" aria-pressed="false"><span class="fs-sample" aria-hidden="true">字</span>大字</button>
    <button type="button" class="fs-opt" data-fs="xl" aria-pressed="false"><span class="fs-sample" aria-hidden="true">字</span>特大</button>
  </div>
  <button type="button" class="fs-toggle" id="fsToggle" aria-expanded="false" aria-controls="fsPanel">
    <span class="fs-toggle-icon" aria-hidden="true">字</span>字體大小
  </button>
</div>

